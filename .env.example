# --- Claude (Ask tab + photo scanning) ------------------------------------
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

# --- Google Sheet (source of truth) ---------------------------------------
# The long id in your sheet's URL, between /d/ and /edit
GOOGLE_SHEET_ID=
# Path to the service-account JSON key. If omitted, any service-account key
# sitting in the project root is used automatically.
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./bertuccilibrary-xxxxxxxx.json

# --- Google Books (cover + ISBN lookup) -----------------------------------
# Without a key you share a small daily allowance and lookups get throttled.
GOOGLE_BOOKS_API_KEY=

# --- BoardGameGeek (board game box art) -----------------------------------
# Register at boardgamegeek.com/using_the_xml_api to get an application token.
# Without this, games use typeset cards or a pasted image URL.
BGG_TOKEN=

# --- Optional -------------------------------------------------------------
# PORT=4173
